# Python
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
# Usually these files are written by a python script from a template
# before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log
junit/

# Local Test Reports (keep the directories in Git if you want, but not the content)
reports/*
!reports/.gitkeep
# Allow this specific Allure file if you commit it
!reports/allure-results/environment.properties
# Allow keeping allure-results dir even if empty
!reports/allure-results/.gitkeep
# Allow keeping allure-report dir even if empty (though it's usually generated)
!reports/allure-report/.gitkeep

# Allure generated report (usually you generate this locally or in CI, not commit the full report)
# If you use GitHub Pages to host the report, the gh-pages branch will handle it.
# For the main branch, you typically only commit allure-results.
# reports/allure-report/  # Uncomment if you absolutely don't want the generated HTML report in git

# Translations
*.mo
*.pot

# Django stuff (not directly relevant but good general Python practice)
# *.log
# local_settings.py
# db.sqlite3
# db.sqlite3-journal

# Flask stuff:
# instance/
# .webassets-cache

# Scrapy stuff:
# .scrapy

# Sphinx documentation
# docs/_build/

# PyBuilder
# target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# PEP 582; __pypackages__
__pypackages__/

# Celery stuff
# celerybeat-schedule
# celerybeat.pid

# SageMath files
# *.sage.py

